---
import Layout from "./Layout.astro";
import SeriesNav from "../components/SeriesNav.astro";
import { conceptsOf, lobeOf, readingMinutes, urlOf, type Post } from "../lib/brain";

interface Props {
  post: Post;
  related: Post[];
  series: Post[];
}

const { post, related, series } = Astro.props;
const { title, description, pubDate } = post.data;
const lobe = lobeOf(post);
---

<Layout title={title} description={description} mode="post" focus={post.id}>
  <div class={`lobe-${lobe} read-progress fixed inset-x-0 top-0 z-30 h-0.5 bg-(--lobe) shadow-[0_0_10px_var(--lobe)]`}></div>

  <main class={`lobe-${lobe} mx-auto max-w-3xl px-4 pt-28 pb-12 sm:px-6`}>
    <a href={`/posts/${lobe}/`} class="font-mono text-xs text-(--lobe) uppercase hover:underline">← {lobe} lobe</a>
    <h1 class="mt-4 font-display text-4xl leading-tight font-bold text-balance sm:text-5xl">{title}</h1>
    <p class="mt-5 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-dim">
      <span>{pubDate.toISOString().slice(0, 10)}</span>
      <span>{readingMinutes(post)} min read</span>
      {conceptsOf(post).map((c) => <span>#{c}</span>)}
    </p>
    {series.length > 0 && <SeriesNav post={post} parts={series} />}

    <article
      class="mt-10 prose max-w-none prose-invert sm:prose-lg
        prose-headings:font-display prose-a:text-(--lobe) prose-img:mx-auto prose-img:rounded-xl"
    >
      <slot />
    </article>
    {series.length > 0 && <SeriesNav post={post} parts={series} pager />}

    {
      related.length > 0 && (
        <section class="mt-16">
          <h2 class="font-display text-2xl font-bold">Connected thoughts</h2>
          <p class="mt-1 font-mono text-xs text-dim">neurons this one fires into: shared ideas first, then neighbours in time.</p>
          <div class="mt-6 grid gap-4 sm:grid-cols-3">
            {related.map((p) => (
              <a href={urlOf(p)} data-neuron={p.id} class={`lobe-${lobeOf(p)} glass flex flex-col gap-2 p-5 transition hover:-translate-y-1 hover:border-(--lobe)/50`}>
                <span class="font-mono text-[11px] text-(--lobe)">{lobeOf(p)} · {p.data.pubDate.getFullYear()}</span>
                <span class="font-display font-medium">{p.data.title}</span>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </main>
</Layout>
