---
import { LOBES, type Lobe } from "../../consts";
import Layout from "../../layouts/Layout.astro";
import PostList from "../../components/PostList.astro";
import { getPosts } from "../../lib/brain";

const posts = await getPosts();
---

<Layout title="Posts" mode="index" through>
  <main class="mx-auto max-w-3xl min-h-[calc(100dvh-7rem)] px-6 pt-32 pb-12 xl:mx-0 xl:ml-[7vw] xl:max-w-[40rem]">
    <h1 class="font-display text-4xl font-bold">Every thought, in order</h1>
    <p class="mt-3 font-mono text-xs text-dim">{posts.length} posts. <span class="pointer-coarse:hidden">hover one to light it up in the field.</span><span class="hidden pointer-coarse:inline">tap one to fly into its neuron.</span></p>
    <div class="mt-8 flex flex-wrap gap-2 font-mono text-xs">
      {
        (Object.keys(LOBES) as Lobe[]).map((l) => (
          <a href={`/posts/${l}/`} data-lobe={l} class={`lobe-${l} rounded-full border border-(--lobe)/40 px-3 py-1.5 text-(--lobe) hover:bg-(--lobe)/10`}>
            {LOBES[l].name}
          </a>
        ))
      }
    </div>
    <div class="mt-8"><PostList posts={posts} /></div>
  </main>
</Layout>
