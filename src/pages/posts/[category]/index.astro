---
import type { GetStaticPaths } from "astro";

import { LOBES, type Lobe } from "../../../consts";
import Layout from "../../../layouts/Layout.astro";
import PostList from "../../../components/PostList.astro";
import { getPosts, lobeOf, type Post } from "../../../lib/brain";

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return (Object.keys(LOBES) as Lobe[]).map((category) => ({
    params: { category },
    props: { category, posts: posts.filter((p) => lobeOf(p) === category) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  category: Lobe;
  posts: Post[];
}

const { category, posts } = Astro.props;
---

<Layout title={LOBES[category].name} mode="index" focus={category} through>
  <main class={`lobe-${category} mx-auto max-w-3xl min-h-[calc(100dvh-7rem)] px-6 pt-32 pb-12 xl:mx-0 xl:ml-[7vw] xl:max-w-[40rem]`}>
    <a href="/posts/" class="font-mono text-xs text-dim hover:text-fg">← every thought</a>
    <p class="mt-6 font-mono text-xs text-(--lobe) uppercase" data-lobe={category}>{category} lobe</p>
    <h1 class="mt-2 font-display text-4xl font-bold">{LOBES[category].name}</h1>
    <p class="mt-3 font-mono text-xs text-dim">{posts.length} {posts.length === 1 ? "post" : "posts"}</p>
    <div class="mt-8"><PostList posts={posts} /></div>
  </main>
</Layout>
