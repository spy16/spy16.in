---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Not found" through>
  <main class="grid min-h-dvh place-items-center px-6 text-center">
    <div class="scrim flex flex-col items-center gap-4 px-16 py-20">
      <h1 data-decode class="font-display text-7xl font-bold [text-shadow:0_0_40px_rgb(120_140_255/.45)]">404</h1>
      <p class="font-mono text-sm text-dim">this neuron doesn't exist. maybe it never fired.</p>
      <a href="/" class="glass mt-2 rounded-full! px-4 py-2 font-mono text-sm hover:text-fg">back to the brain</a>
    </div>
  </main>
</Layout>
