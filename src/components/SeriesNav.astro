---
import { urlOf, type Post } from "../lib/brain";

interface Props {
  post: Post;
  parts: Post[];
  pager?: boolean;
}

const { post, parts, pager = false } = Astro.props;
const i = parts.findIndex((p) => p.id === post.id);
const prev = parts[i - 1];
const next = parts[i + 1];
---

{
  pager ? (
    <nav class="mt-16 grid gap-4 sm:grid-cols-2" aria-label={`${post.data.series} series`}>
      {prev ? (
        <a href={urlOf(prev)} class="glass flex flex-col gap-1 p-5 transition hover:border-(--lobe)/50">
          <span class="font-mono text-[11px] text-dim">← previous</span>
          <span class="font-display font-medium">{prev.data.title}</span>
        </a>
      ) : <span />}
      {next && (
        <a href={urlOf(next)} class="glass flex flex-col gap-1 p-5 text-right transition hover:border-(--lobe)/50 sm:col-start-2">
          <span class="font-mono text-[11px] text-dim">next →</span>
          <span class="font-display font-medium">{next.data.title}</span>
        </a>
      )}
    </nav>
  ) : (
    <details class="glass mt-8 px-5 py-3">
      <summary class="cursor-pointer font-mono text-xs text-(--lobe)">
        {post.data.series} · part {post.data.part} · all parts
      </summary>
      <ol class="mt-3 flex flex-col gap-1.5 pb-2 text-sm">
        {parts.map((p) => (
          <li class="grid grid-cols-[2rem_1fr]">
            <span class="font-mono text-dim">{p.data.part}</span>
            {p.id === post.id ? <span class="text-fg">{p.data.title}</span> : <a href={urlOf(p)} class="text-dim hover:text-(--lobe)">{p.data.title}</a>}
          </li>
        ))}
      </ol>
    </details>
  )
}
