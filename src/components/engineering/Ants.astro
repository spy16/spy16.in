---
import "../widget/widget.css";
---

<div class="w not-prose" data-widget="ants">
  <span class="w-label">Ants with four rules, no map · tap to drop food</span>
  <canvas class="w-canvas" aria-label="An ant foraging simulation: ants lay and follow scent trails between their nest and food"></canvas>
  <ol class="an-rules">
    <li>Wander, leaning toward the strongest <b class="an-food">food scent</b> ahead.</li>
    <li>Found food: pick it up and turn around.</li>
    <li>Carrying: follow <b class="an-home">nest scent</b> home, leaving food scent behind.</li>
    <li>Not carrying: leave nest scent behind.</li>
  </ol>
  <div class="w-controls">
    <label class="w-ctl">scent fades <b data-out="evap"></b><input data-in="evap" type="range" min="0" max="4" step="1" value="2" /></label>
    <div class="w-btns"><button class="w-btn" data-act="play">Pause</button><button class="w-btn ghost" data-act="reset">Reset</button></div>
  </div>
  <div class="w-readout an-readout">
    <div class="w-cell"><span>food brought home</span><b class="w-grad" data-out="food">0</b></div>
    <div class="w-cell"><span>ants carrying</span><b class="w-fwd" data-out="carrying">0</b></div>
  </div>
  <p class="w-log">No ant knows where the food is or which trail is best. Short trails get walked more often, so they stay strong while long ones fade, and the colony converges on them.</p>
</div>

<style is:global>
  .w .an-rules { margin: 0; padding-left: 1.25rem; list-style: decimal; font-size: 0.85rem; color: var(--color-dim); display: grid; gap: 0.15rem; }
  .w .an-food { color: rgb(196 140 255); }
  .w .an-home { color: rgb(79 209 255); }
  .w .an-readout { grid-template-columns: repeat(2, minmax(0, 1fr)); }
</style>

<script>
  import { $, animate, canvasPoint, fitCanvas, mountAll } from "../widget/widget";

  const W = 640, H = 380, CELL = 4, GW = W / CELL, GH = H / CELL;
  const SPEED = 55, SENSE = 12, SPREAD = 0.6, TURN = 3.2, JITTER = 1.6;
  const NEST = { x: W * 0.22, y: H * 0.55, r: 16 };
  const EVAP = [0.05, 0.12, 0.25, 0.6, 1.5];
  const EVAP_LABEL = ["very slowly", "slowly", "normally", "fast", "very fast"];

  type Ant = { x: number; y: number; a: number; carry: boolean; since: number };
  type Food = { x: number; y: number; left: number };

  mountAll("ants", (root) => {
    const cv = $<HTMLCanvasElement>(root, "canvas");
    const ctx = fitCanvas(cv, W, H);
    const field = document.createElement("canvas"); field.width = GW; field.height = GH;
    const fctx = field.getContext("2d")!, img = fctx.createImageData(GW, GH);
    const n = innerWidth < 640 ? 160 : 260;
    const toFood = new Float32Array(GW * GH), toHome = new Float32Array(GW * GH);
    const evapIn = $<HTMLInputElement>(root, '[data-in="evap"]');
    const out = (k: string, v: string) => ($(root, `[data-out="${k}"]`).textContent = v);
    let ants: Ant[] = [], foods: Food[] = [], collected = 0;

    const reset = () => {
      toFood.fill(0); toHome.fill(0); collected = 0;
      ants = Array.from({ length: n }, () => ({ x: NEST.x, y: NEST.y, a: Math.random() * Math.PI * 2, carry: false, since: 0 }));
      foods = [{ x: W * 0.8, y: H * 0.25, left: 300 }, { x: W * 0.7, y: H * 0.8, left: 300 }];
    };

    const cell = (x: number, y: number) => {
      const cx = Math.floor(x / CELL), cy = Math.floor(y / CELL);
      return cx < 0 || cy < 0 || cx >= GW || cy >= GH ? -1 : cy * GW + cx;
    };
    const smell = (f: Float32Array, x: number, y: number) => { const i = cell(x, y); return i < 0 ? -1 : f[i]; };

    const step = (dt: number) => {
      for (const ant of ants) {
        const follow = ant.carry ? toHome : toFood;
        const l = smell(follow, ant.x + Math.cos(ant.a - SPREAD) * SENSE, ant.y + Math.sin(ant.a - SPREAD) * SENSE);
        const c = smell(follow, ant.x + Math.cos(ant.a) * SENSE, ant.y + Math.sin(ant.a) * SENSE);
        const r = smell(follow, ant.x + Math.cos(ant.a + SPREAD) * SENSE, ant.y + Math.sin(ant.a + SPREAD) * SENSE);
        if (l > c && l > r) ant.a -= TURN * dt; else if (r > c && r > l) ant.a += TURN * dt;
        ant.a += (Math.random() - 0.5) * JITTER * 2 * dt * 4;
        ant.x += Math.cos(ant.a) * SPEED * dt; ant.y += Math.sin(ant.a) * SPEED * dt;
        if (ant.x < 2 || ant.x > W - 2) { ant.a = Math.PI - ant.a; ant.x = Math.min(W - 2, Math.max(2, ant.x)); }
        if (ant.y < 2 || ant.y > H - 2) { ant.a = -ant.a; ant.y = Math.min(H - 2, Math.max(2, ant.y)); }
        ant.since += dt;
        const i = cell(ant.x, ant.y), s = Math.max(0, 1 - ant.since / 25);
        if (i >= 0 && s > 0) { const f = ant.carry ? toFood : toHome; f[i] = Math.max(f[i], s); }
        if (!ant.carry) {
          for (const food of foods) if (food.left > 0 && Math.hypot(ant.x - food.x, ant.y - food.y) < 10 + Math.sqrt(food.left)) {
            food.left--; ant.carry = true; ant.a += Math.PI; ant.since = 0; break;
          }
        } else if (Math.hypot(ant.x - NEST.x, ant.y - NEST.y) < NEST.r) {
          ant.carry = false; ant.a += Math.PI; ant.since = 0; collected++;
        } else if (Math.hypot(ant.x - NEST.x, ant.y - NEST.y) < NEST.r * 2.5) ant.a = Math.atan2(NEST.y - ant.y, NEST.x - ant.x);
        if (!ant.carry && Math.hypot(ant.x - NEST.x, ant.y - NEST.y) < NEST.r) ant.since = 0;
      }
      const k = Math.exp(-EVAP[+evapIn.value] * dt);
      for (let i = 0; i < toFood.length; i++) { toFood[i] *= k; toHome[i] *= k; }
      foods = foods.filter((f) => f.left > 0);
    };

    const draw = () => {
      const d = img.data;
      for (let i = 0; i < toFood.length; i++) {
        const f = Math.min(1, toFood[i] * 1.6), h = Math.min(1, toHome[i] * 1.2);
        d[i * 4] = 196 * f + 79 * h * 0.5;
        d[i * 4 + 1] = 140 * f + 209 * h * 0.5;
        d[i * 4 + 2] = 255 * f + 255 * h * 0.5;
        d[i * 4 + 3] = 255 * Math.min(1, f * 0.9 + h * 0.35);
      }
      fctx.putImageData(img, 0, 0);
      ctx.clearRect(0, 0, W, H);
      ctx.imageSmoothingEnabled = true;
      ctx.drawImage(field, 0, 0, W, H);
      ctx.fillStyle = "rgb(79 209 255 / 0.25)"; ctx.strokeStyle = "rgb(79 209 255)";
      ctx.beginPath(); ctx.arc(NEST.x, NEST.y, NEST.r, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
      for (const f of foods) {
        ctx.fillStyle = "rgb(111 211 154 / 0.85)";
        ctx.beginPath(); ctx.arc(f.x, f.y, 4 + Math.sqrt(f.left), 0, Math.PI * 2); ctx.fill();
      }
      let carrying = 0;
      for (const ant of ants) {
        if (ant.carry) carrying++;
        ctx.fillStyle = ant.carry ? "#ffb45c" : "rgb(230 235 255 / 0.8)";
        ctx.fillRect(ant.x - 1.2, ant.y - 1.2, 2.4, 2.4);
      }
      out("food", String(collected)); out("carrying", String(carrying));
      out("evap", EVAP_LABEL[+evapIn.value]);
    };

    cv.addEventListener("click", (e) => { foods.push({ ...canvasPoint(cv, e, W, H), left: 200 }); draw(); });
    evapIn.addEventListener("input", draw);
    $(root, '[data-act="reset"]').addEventListener("click", () => { reset(); draw(); });
    reset(); draw();
    animate(root, (dt) => { step(dt); step(dt); draw(); }, $<HTMLButtonElement>(root, '[data-act="play"]'));
  });
</script>
