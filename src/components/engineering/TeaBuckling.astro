---
import "../widget/widget.css";
---

<div class="w not-prose" data-widget="tea-buckling">
  <span class="w-label">A lidded cup of tea, sealed at 85 °C · top view and the critical pressure of each mode</span>
  <div class="tb-figs">
    <div class="w-fig"><svg data-fig="cup" role="img" aria-label="Top view of the cup's wall, buckling into a star as the tea cools"></svg></div>
    <div class="w-fig"><svg data-fig="modes" role="img" aria-label="Bar chart: pressure needed to buckle the wall into each number of lobes, against the current vacuum"></svg></div>
  </div>
  <div class="w-controls">
    <label class="w-ctl">tea temperature <b data-out="T"></b><input data-in="T" type="range" min="25" max="85" step="0.5" value="85" /></label>
    <div class="w-btns"><button class="w-btn" data-act="cool">Let it cool</button></div>
  </div>
  <div class="w-controls">
    <label class="w-ctl">radius R <b data-out="R"></b><input data-in="R" type="range" min="30" max="60" step="1" value="45" /></label>
    <label class="w-ctl">height L <b data-out="L"></b><input data-in="L" type="range" min="40" max="120" step="1" value="70" /></label>
    <label class="w-ctl">wall t <b data-out="t"></b><input data-in="t" type="range" min="0.2" max="0.8" step="0.05" value="0.45" /></label>
  </div>
  <div class="w-readout tb-readout">
    <div class="w-cell"><span>vacuum inside</span><b class="w-grad" data-out="dp"></b></div>
    <div class="w-cell"><span>wall gives at</span><b class="w-fwd" data-out="pcr"></b></div>
    <div class="w-cell"><span>lobes</span><b data-out="n"></b></div>
  </div>
  <p class="w-explain" data-out="explain"></p>
  <p class="w-log">Polypropylene, stiffness falling from 1.4 GPa at 25 °C to 0.55 GPa at 85 °C. Critical pressures use von Mises' formula for a thin cylinder with supported ends; the dent depth is illustrative.</p>
</div>

<style is:global>
  .w .tb-figs { display: grid; gap: 0.75rem; }
  @media (min-width: 40rem) { .w .tb-figs { grid-template-columns: 1fr 1.25fr; align-items: center; } }
  [data-widget="tea-buckling"] svg[data-fig="cup"] { max-width: 16rem; margin-inline: auto; }
  .w .tb-readout { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .w .tb-ghost { fill: none; stroke: var(--rule); stroke-dasharray: 4 4; }
  .w .tb-wall { fill: rgb(196 140 92 / 0.28); stroke: var(--color-fg); stroke-width: 2.5; stroke-linejoin: round; }
  .w .tb-lbl { fill: var(--color-dim); font: 12px var(--font-mono); }
  .w .tb-big { fill: var(--color-fg); font: 600 15px var(--font-mono); }
  .w .tb-bar { fill: rgb(120 168 255 / 0.35); }
  .w .tb-bar.crit { fill: var(--fwd); }
  .w .tb-bar.over { fill: rgb(255 180 92 / 0.55); }
  .w .tb-bar.over.crit { fill: var(--grad); stroke: var(--color-fg); stroke-width: 1.5; }
  .w .tb-line { stroke: var(--grad); stroke-width: 2; stroke-dasharray: 5 3; }
</style>

<script>
  import { $, mountAll, reduceMotion } from "../widget/widget";

  const SEAL_C = 85, ATM = 101.325, NU = 0.4, N_MAX = 16, COOL_S = 9;
  const NS = "http://www.w3.org/2000/svg";

  const psat = (c: number) => 0.61121 * Math.exp((18.678 - c / 234.5) * (c / (257.14 + c)));
  const vacuum = (c: number) => {
    const air0 = ATM - psat(SEAL_C);
    return Math.max(0, ATM - (air0 * (c + 273.15)) / (SEAL_C + 273.15) - psat(c));
  };
  const modulusPa = (c: number) => (0.55 + ((85 - c) / 60) * 0.85) * 1e9;
  // von Mises, simply supported ends, one axial half-wave; lengths in mm cancel, result in Pa.
  const pcrPa = (n: number, E: number, R: number, L: number, t: number) => {
    const l = (Math.PI * R) / L, k = n * n + l * l;
    return (E * t / R) * (l ** 4 / (k * k * (n * n - 1))) + (E * t ** 3 / (12 * (1 - NU * NU) * R ** 3)) * (k * k / (n * n - 1));
  };

  mountAll("tea-buckling", (root) => {
    const inp = (k: string) => $<HTMLInputElement>(root, `[data-in="${k}"]`);
    const out = (k: string, v: string) => ($(root, `[data-out="${k}"]`).textContent = v);
    const cup = $<SVGSVGElement>(root, '[data-fig="cup"]'), modes = $<SVGSVGElement>(root, '[data-fig="modes"]');
    cup.setAttribute("viewBox", "0 0 220 220");
    modes.setAttribute("viewBox", "0 0 320 200");
    const el = (svg: SVGSVGElement, tag: string, attrs: Record<string, string | number>, text?: string) => {
      const e = document.createElementNS(NS, tag);
      for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
      if (text !== undefined) e.textContent = text;
      svg.appendChild(e);
      return e;
    };

    const draw = () => {
      const T = +inp("T").value, R = +inp("R").value, L = +inp("L").value, t = +inp("t").value, E = modulusPa(T);
      const dp = vacuum(T) * 1000;
      const ps = Array.from({ length: N_MAX - 1 }, (_, i) => ({ n: i + 2, p: pcrPa(i + 2, E, R, L, t) }));
      const crit = ps.reduce((a, b) => (b.p < a.p ? b : a));
      const buckled = dp > crit.p;
      const depth = buckled ? Math.min(0.16, 0.035 * Math.log(dp / crit.p) + 0.03) : 0;

      cup.replaceChildren();
      const cx = 110, cy = 104, r0 = 78;
      el(cup, "circle", { cx, cy, r: r0, class: "tb-ghost" });
      let d = "";
      for (let k = 0; k <= 360; k++) {
        const th = (k / 360) * Math.PI * 2, r = r0 * (1 - depth * (1 + Math.cos(crit.n * th)) / 2);
        d += `${k ? "L" : "M"}${(cx + r * Math.sin(th)).toFixed(1)},${(cy - r * Math.cos(th)).toFixed(1)}`;
      }
      el(cup, "path", { d: d + "Z", class: "tb-wall" });
      el(cup, "text", { x: cx, y: cy + 5, "text-anchor": "middle", class: "tb-big" }, buckled ? `n = ${crit.n}` : "round");
      el(cup, "text", { x: cx, y: 214, "text-anchor": "middle", class: "tb-lbl" }, buckled ? `w(θ) ∝ cos(${crit.n}θ)` : "holding");

      modes.replaceChildren();
      const X0 = 34, X1 = 312, Y0 = 16, Y1 = 170, lo = 2, hi = 6;
      const y = (p: number) => Y1 - ((Math.log10(Math.max(p, 10 ** lo)) - lo) / (hi - lo)) * (Y1 - Y0);
      const bw = (X1 - X0) / ps.length;
      for (const k of [2, 3, 4, 5, 6]) el(modes, "text", { x: X0 - 4, y: y(10 ** k) + 4, "text-anchor": "end", class: "tb-lbl" }, k === 3 ? "1k" : k === 4 ? "10k" : k === 5 ? "100k" : k === 6 ? "1M" : "100");
      ps.forEach((m, i) => {
        const x = X0 + i * bw + 2, top = y(m.p);
        el(modes, "rect", { x, y: top, width: bw - 4, height: Math.max(1, Y1 - top), rx: 2, class: `tb-bar${m.p < dp ? " over" : ""}${m === crit ? " crit" : ""}` });
        if (m.n % 2 === 0 || m === crit) el(modes, "text", { x: x + (bw - 4) / 2, y: Y1 + 14, "text-anchor": "middle", class: "tb-lbl" }, String(m.n));
      });
      if (dp > 10 ** lo) el(modes, "line", { x1: X0, x2: X1, y1: y(dp), y2: y(dp), class: "tb-line" });
      el(modes, "text", { x: X1, y: Y1 + 28, "text-anchor": "end", class: "tb-lbl" }, "lobes n → (pressure in Pa, log scale)");

      out("T", `${T.toFixed(0)} °C`); out("R", `${R} mm`); out("L", `${L} mm`); out("t", `${t.toFixed(2)} mm`);
      out("dp", `${(dp / 1000).toFixed(1)} kPa`); out("pcr", `${(crit.p / 1000).toFixed(1)} kPa`); out("n", buckled ? String(crit.n) : "–");
      out("explain", buckled
        ? `The outside air pushes ${(dp / 1000).toFixed(0)} kPa harder than the inside, past the ${(crit.p / 1000).toFixed(1)} kPa the wall can take. Mode ${crit.n} has the shortest bar, so the wall caves into ${crit.n} lobes. Fewer lobes would have to stretch the wall along its height; more would have to bend it tighter.`
        : `Each bar is the pressure difference needed to dent the wall into that many lobes. The dashed line is the vacuum inside the cup, and it rises as the tea cools. The first bar it crosses decides the shape.`);
    };

    root.querySelectorAll("input").forEach((i) => i.addEventListener("input", draw));
    const cool = $<HTMLButtonElement>(root, '[data-act="cool"]');
    cool.addEventListener("click", () => {
      inp("T").value = String(SEAL_C);
      if (reduceMotion()) { inp("T").value = "40"; draw(); return; }
      cool.disabled = true;
      const start = performance.now();
      const tick = (now: number) => {
        const f = Math.min(1, (now - start) / (COOL_S * 1000));
        inp("T").value = String(SEAL_C - (SEAL_C - 40) * (1 - (1 - f) ** 2));
        draw();
        if (f < 1) requestAnimationFrame(tick); else cool.disabled = false;
      };
      requestAnimationFrame(tick);
    });
    draw();
  });
</script>
