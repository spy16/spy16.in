---
import "./widget.css";
---

<div class="w not-prose" data-widget="slope">
  <span class="w-label">Nudge explorer · <code>f(x) = (x − 2)² + 1</code></span>
  <div class="w-fig"><svg role="img" aria-label="Plot of f(x) = (x-2)^2 + 1 with the slope at the chosen x"></svg></div>
  <div class="w-controls">
    <label class="w-ctl">knob x = <b data-out="x"></b><input data-in="x" type="range" min="-1" max="5" step="0.01" value="3.5" /></label>
    <label class="w-ctl">nudge h = <b data-out="h"></b><input data-in="h" type="range" min="0" max="5" step="1" value="0" /></label>
  </div>
  <div class="w-readout">
    <div class="w-cell"><span>f(x)</span><b class="w-fwd" data-out="fx"></b></div>
    <div class="w-cell"><span>f(x + h)</span><b class="w-fwd" data-out="fxh"></b></div>
    <div class="w-cell"><span>nudge slope (f(x+h) − f(x)) / h</span><b data-out="ns"></b></div>
    <div class="w-cell"><span>true slope 2(x − 2)</span><b class="w-grad" data-out="ts"></b></div>
  </div>
  <span class="w-label">Roll downhill · <code>x = x − learning_rate × slope</code></span>
  <div class="w-controls">
    <label class="w-ctl">learning rate = <b data-out="lr"></b><input data-in="lr" type="range" min="0.05" max="1.05" step="0.05" value="0.2" /></label>
    <div class="w-btns"><button class="w-btn" data-act="roll">Roll 20 steps</button><button class="w-btn ghost" data-act="clear">Clear trail</button></div>
  </div>
  <div class="w-log" aria-live="polite"></div>
</div>

<script>
  import * as d3 from "d3";
  import { $, fmt, mountAll, reduceMotion } from "./widget";

  const f = (x: number) => (x - 2) ** 2 + 1;
  const df = (x: number) => 2 * (x - 2);
  const HS = [1, 0.5, 0.1, 0.01, 0.001, 0.0001];
  const W = 640, H = 320, m = { t: 14, r: 16, b: 30, l: 36 };

  mountAll("slope", (root) => {
    const X = d3.scaleLinear([-1, 5], [m.l, W - m.r]);
    const Y = d3.scaleLinear([0, 10.5], [H - m.b, m.t]);
    const svg = d3.select($(root, "svg")).attr("viewBox", `0 0 ${W} ${H}`);
    const clipId = `clip-${Math.random().toString(36).slice(2)}`;
    svg.append("clipPath").attr("id", clipId).append("rect").attr("x", m.l).attr("y", m.t).attr("width", W - m.l - m.r).attr("height", H - m.t - m.b);
    svg.append("g").selectAll("line").data(Y.ticks(5)).join("line").attr("class", "gridline").attr("x1", m.l).attr("x2", W - m.r).attr("y1", Y).attr("y2", Y);
    svg.append("g").attr("class", "axis").attr("transform", `translate(0,${H - m.b})`).call(d3.axisBottom(X).ticks(6));
    svg.append("g").attr("class", "axis").attr("transform", `translate(${m.l},0)`).call(d3.axisLeft(Y).ticks(5));
    const plot = svg.append("g").attr("clip-path", `url(#${clipId})`);
    plot.append("path").attr("class", "curve").attr("d", d3.line<number>().x(X).y((x) => Y(f(x)))(d3.range(-1, 5.001, 0.02)));
    const trailG = plot.append("g");
    const tangent = plot.append("line").attr("class", "tangent");
    const secant = plot.append("line").attr("class", "secant");
    const tri = plot.append("path").attr("class", "tri");
    const dot2 = plot.append("circle").attr("class", "dot2").attr("r", 4);
    const dot = plot.append("circle").attr("class", "dot").attr("r", 6);

    const inp = (k: string) => $<HTMLInputElement>(root, `[data-in="${k}"]`);
    const out = (k: string, v: string) => ($(root, `[data-out="${k}"]`).textContent = v);
    const log = $(root, ".w-log");
    let trail: number[] = [];

    const draw = () => {
      const x = +inp("x").value, h = HS[+inp("h").value], s = df(x), y = f(x), x2 = x + h, y2 = f(x2), ss = (y2 - y) / h;
      out("x", fmt(x)); out("h", String(h)); out("lr", fmt(+inp("lr").value));
      out("fx", fmt(y, 4)); out("fxh", fmt(y2, 4)); out("ns", fmt(ss, 4)); out("ts", fmt(s, 4));
      const span = 1.3;
      tangent.attr("x1", X(x - span)).attr("y1", Y(y - s * span)).attr("x2", X(x + span)).attr("y2", Y(y + s * span));
      secant.attr("x1", X(x - span)).attr("y1", Y(y - ss * span)).attr("x2", X(x + span)).attr("y2", Y(y + ss * span));
      tri.attr("d", `M${X(x)},${Y(y)}H${X(x2)}V${Y(y2)}`);
      dot.attr("cx", X(x)).attr("cy", Y(y));
      dot2.attr("cx", X(x2)).attr("cy", Y(y2)).attr("opacity", h >= 0.1 ? 1 : 0);
      trailG.selectAll("circle").data(trail).join("circle").attr("class", "trail").attr("r", 4).attr("cx", (d) => X(d)).attr("cy", (d) => Y(f(d)));
    };
    ["x", "h", "lr"].forEach((k) => inp(k).addEventListener("input", draw));

    $(root, '[data-act="clear"]').addEventListener("click", () => { trail = []; log.textContent = ""; draw(); });
    const roll = $<HTMLButtonElement>(root, '[data-act="roll"]');
    roll.addEventListener("click", () => {
      const lr = +inp("lr").value;
      let k = 0;
      trail = [+inp("x").value];
      roll.disabled = true;
      const tick = () => {
        const x = +inp("x").value, s = df(x), nx = x - lr * s;
        k++;
        if (nx < -1 || nx > 5) {
          log.textContent = `step ${k}: x would jump to ${fmt(nx)}, off the chart. The learning rate is too big, so each step overshoots further.`;
          roll.disabled = false; draw(); return false;
        }
        inp("x").value = String(nx); trail.push(nx);
        log.textContent = `step ${k}: slope ${fmt(s, 3)} → x = ${fmt(x, 3)} − ${fmt(lr)} × ${fmt(s, 3)} = ${fmt(nx, 3)}, f(x) = ${fmt(f(nx), 4)}`;
        draw();
        if (k >= 20) { roll.disabled = false; return false; }
        return true;
      };
      if (reduceMotion()) { while (tick()); return; }
      const id = setInterval(() => { if (!tick()) clearInterval(id); }, 220);
    });
    draw();
  });
</script>
