---
interface Props {
  q: string;
}

const { q } = Astro.props;
---

<details class="glass not-prose my-4 px-5 py-3">
  <summary class="cursor-pointer leading-relaxed">
    <span class="mr-2 font-mono text-xs text-(--lobe) uppercase">quiz</span>{q}
  </summary>
  <div class="mt-3 border-t border-white/10 pt-3 pb-1 leading-relaxed text-fg/90 [&_code]:font-mono [&_code]:text-[0.9em] [&_p+p]:mt-2">
    <slot />
  </div>
</details>
